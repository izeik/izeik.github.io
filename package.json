{
  "name": "everyday-english-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" README.md package.json vite.config.ts tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" README.md package.json vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vuetify": "^3.8.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
